# === BitBot Environment Variables ===

# Binance API (read-only keys are sufficient for paper trading)
# Create at: https://www.binance.com/en/my/settings/api-management
# Recommended: enable IP whitelist, disable withdrawals
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Anthropic Claude API (for LLM sentiment analysis layer)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# CryptoPanic API (for news headlines in sentiment analysis)
# Get key at: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=
